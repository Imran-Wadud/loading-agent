# Loading Agent — Python/Reflex application
# Copy to .env and replace placeholders locally. Never commit .env.

# METERLESS NIGHTSHIFT / NVIDIA MODEL ROUTING
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=replace-with-nightshift-runtime-token
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# false prefers Nightshift/Nemotron. The NVIDIA provider key belongs in Nightshift, not here.
USE_GEMINI_PRIMARY=false

# Optional direct Gemini fallback (leave blank if you have no Gemini API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# METERLESS WORLD MODEL SERVICE BRIDGE
METERLESS_WORLD_MODEL_ENABLED=true
METERLESS_WORLD_MODEL_URL=http://127.0.0.1:8090
METERLESS_WORLD_MODEL_TIMEOUT_SECONDS=2.5
# true makes persistence failure fail the request; use false only if persistence is optional.
METERLESS_WORLD_MODEL_REQUIRED=true

# ZETARIS DATA LAYER
ZETARIS_BASE_URL=http://localhost:8888/api/v1.0
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_HOST=localhost
ZETARIS_PORT=10000
ZETARIS_USER=replace-with-zetaris-user
ZETARIS_PASSWORD=replace-with-zetaris-password
ZETARIS_API_KEY=replace-with-zetaris-api-key

# LOADING AGENT APPLICATION POSTGRESQL DATABASE
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=zetaris
DB_PASSWORD=replace-with-postgres-password
# Compatibility aliases if your local adapter/container setup reads these names.
POSTGRES_USER=zetaris
POSTGRES_PASSWORD=replace-with-postgres-password
