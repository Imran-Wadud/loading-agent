# METERLESS / NVIDIA POWER LAYER  
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your_meterless_token_here
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# FALLBACK LLM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# SWITCH LLM (FOR FASTER TESTING SWITCH TO TRUE)
USE_GEMINI_PRIMARY=false

# ZETARIS DATA LAYER
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your_zetaris_api_key_here

POSTGRES_USER=zetaris
POSTGRES_PASSWORD=your_postgres_password_here